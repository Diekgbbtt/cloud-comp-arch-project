[
  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "name": "parsec-freqmine"
      },
      "name": "parsec-freqmine"
    },
    "spec": {
      "template": {
        "spec": {
          "containers": [
            {
              "args": [
                "-c",
                "taskset -c 0-3 ./run -a run -S parsec -p freqmine -i native -n 2"
              ],
              "command": [
                "/bin/sh"
              ],
              "image": "anakli/cca:parsec_freqmine",
              "imagePullPolicy": "IfNotPresent",
              "name": "parsec-freqmine",
              "resources": {
                "limits": {
                  "cpu": "4",
                  "memory": "4Gi"
                },
                "requests": {
                  "cpu": "2",
                  "memory": "2Gi"
                }
              }
            }
          ],
          "nodeSelector": {
            "cca-project-nodetype": "node-b-4core"
          },
          "restartPolicy": "Never"
        }
      }
    }
  }
]