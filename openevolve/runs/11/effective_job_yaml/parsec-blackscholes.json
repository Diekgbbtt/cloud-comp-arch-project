[
  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "name": "parsec-blackscholes"
      },
      "name": "parsec-blackscholes"
    },
    "spec": {
      "template": {
        "spec": {
          "containers": [
            {
              "args": [
                "-c",
                "taskset -c 1-7 ./run -a run -S parsec -p blackscholes -i native -n 7"
              ],
              "command": [
                "/bin/sh"
              ],
              "image": "anakli/cca:parsec_blackscholes",
              "imagePullPolicy": "IfNotPresent",
              "name": "parsec-blackscholes",
              "resources": {
                "limits": {
                  "cpu": "7"
                },
                "requests": {
                  "cpu": "6"
                }
              }
            }
          ],
          "nodeSelector": {
            "cca-project-nodetype": "node-a-8core"
          },
          "restartPolicy": "Never"
        }
      }
    }
  }
]