[
  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "name": "parsec-streamcluster"
      },
      "name": "parsec-streamcluster"
    },
    "spec": {
      "template": {
        "spec": {
          "containers": [
            {
              "args": [
                "-c",
                "taskset -c 0-3 ./run -a run -S parsec -p streamcluster -i native -n 4"
              ],
              "command": [
                "/bin/sh"
              ],
              "image": "anakli/cca:parsec_streamcluster",
              "imagePullPolicy": "IfNotPresent",
              "name": "parsec-streamcluster",
              "resources": {
                "limits": {
                  "cpu": "4"
                },
                "requests": {
                  "cpu": "3"
                }
              }
            }
          ],
          "nodeSelector": {
            "cca-project-nodetype": "node-b-4core"
          },
          "restartPolicy": "Never"
        }
      }
    }
  }
]